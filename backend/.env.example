# Copy this file to .env in the same folder as main.py and fill in real values.
# Never commit the real .env file.

APP_NAME=AI Website Generation Platform
APP_VERSION=1.0.0
ENVIRONMENT=development

# Comma-separated list, or "*" for local dev
CORS_ORIGINS=*

# ---------------------------------
# LLM
# ---------------------------------
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=your_groq_api_key_here

WEBSITE_LLM_TEMPERATURE=0.4
WEBSITE_LLM_MAX_TOKENS=32768

# ---------------------------------
# Website Generation LLM (planner/content/design/layout/codegen/edit
# agents). All optional — leave blank to reuse the LLM_* values above.
# Per the plan of "Gemini free during testing, Claude/GPT in production",
# this is commonly a different provider from the chat LLM above:
#
#   WEBSITE_LLM_PROVIDER=gemini
#   WEBSITE_LLM_MODEL=gemini-1.5-flash
#   WEBSITE_LLM_API_KEY=your_gemini_api_key_here
# ---------------------------------
WEBSITE_LLM_PROVIDER=
WEBSITE_LLM_MODEL=
WEBSITE_LLM_API_KEY=
WEBSITE_LLM_TEMPERATURE=0.4
WEBSITE_LLM_MAX_TOKENS=8192
WEBSITE_STORAGE_DIR=./data/websites

# ---------------------------------
# Project storage (BusinessProfile + generated system prompt)
# ---------------------------------
STORAGE_DIR=./data/projects

# ---------------------------------
# Knowledge Base service (the ingestion/vector-search API in ../knowledge_base)
# ---------------------------------
KNOWLEDGE_BASE_BASE_URL=http://localhost:8001
KNOWLEDGE_BASE_API_KEY=
KNOWLEDGE_BASE_RETRIEVE_PATH=/knowledge/retrieve
KNOWLEDGE_BASE_TOP_K=5
KNOWLEDGE_BASE_TIMEOUT_SECONDS=15

# ---------------------------------
# Guardrails
# ---------------------------------
GUARDRAILS_ENABLED=true
