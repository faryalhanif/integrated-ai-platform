# Copy this file to .env in the same folder as main.py and fill in real values.
# Never commit the real .env file.

APP_NAME=Knowledge Base Service
APP_VERSION=1.0.0
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8001

# Comma-separated list, or "*" for local dev
CORS_ORIGINS=*

# ---------------------------------
# LLM (only used to summarize extracted tables before embedding)
# ---------------------------------
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=your_groq_api_key_here
LLM_TEMPERATURE=0.0
TABLE_SUMMARIZATION_ENABLED=true

# ---------------------------------
# Embeddings
# ---------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ---------------------------------
# Vector store
# ---------------------------------
CHROMA_PERSIST_DIR=./data/vector_store
CHROMA_DISTANCE_METRIC=cosine

# ---------------------------------
# Chunking
# ---------------------------------
CHUNK_SIZE=600
CHUNK_OVERLAP=90

# ---------------------------------
# Retrieval
# ---------------------------------
DEFAULT_TOP_K=5
MIN_RELEVANCE_SCORE=0.0

# ---------------------------------
# File uploads
# ---------------------------------
UPLOAD_TMP_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ---------------------------------
# Web ingestion
# ---------------------------------
# Optional external extraction microservice. Leave blank to use the
# built-in httpx + BeautifulSoup fallback extractor.
WEB_EXTRACTION_SERVICE_URL=
WEB_EXTRACTION_SERVICE_PATH=/extract
WEB_FETCH_TIMEOUT_SECONDS=30

# ---------------------------------
# OCR
# ---------------------------------
# Leave blank to use tesseract from PATH. On Windows, set the full path
# to tesseract.exe, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ---------------------------------
# Auth
# ---------------------------------
# Must match KNOWLEDGE_BASE_API_KEY in the backend's .env. Leave blank
# to disable auth (local dev only).
SERVICE_API_KEY=
